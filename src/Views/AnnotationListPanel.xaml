<Window x:Class="XAnnotation.Views.AnnotationListPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批注清单" Width="1060" Height="700"
        MinWidth="820" MinHeight="540"
        ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="True"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F4F6FA">

    <!--
      批注清单（列表型界面）

      布局：头部工具卡（标题 + 状态筛选 + 搜索/操作）→ 表格卡 → 详情卡 → 底部统计条。
      数据全部由 AnnotationListPanel.xaml.cs 填充；本文件不含任何业务逻辑。

      改这里的注意事项：
      - 列宽：序号52 编号76 专业78 图号100 摘要(动态) 批注人76 时间106 状态100。
        「意见摘要」是唯一弹性列，宽度由 ResizeSummaryColumn() 按窗口宽度算，
        改上面任何一个固定宽度必须同步改 code-behind 里的 FixedColumnsWidth。
      - 行模板用 GridViewRowPresenter，单元格的内边距统一由 CellText 样式的 Margin 给（12），
        表头 Padding 也是 12，两边才对得上。
      - 状态配色只在这里（DataTrigger），不走代码：待处理=红、已回复=琥珀、已完成=绿。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/XTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 卡片 -->
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E6EBF2"/>
            <SolidColorBrush x:Key="RowDividerBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#EFF6FF"/>

            <!-- 单元格文字：左内边距 12 与表头的 Padding 对齐 -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="12,0,6,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>

            <!-- 表头：浅底、11 号、细下边框 -->
            <Style x:Key="HeadStyle" TargetType="GridViewColumnHeader">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#EDF1F6"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 表格行：38 高、下细分隔线，悬停浅灰、选中浅蓝并在左侧留一道 3px 蓝条 -->
            <Style x:Key="RowStyle" TargetType="ListViewItem">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="RowBorder" Background="Transparent"
                                    BorderBrush="{StaticResource RowDividerBrush}"
                                    BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="SelectMark" Width="3" HorizontalAlignment="Left"
                                               Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                                    <GridViewRowPresenter VerticalAlignment="Center"
                                                          Content="{TemplateBinding Content}"
                                                          Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                                    <Setter TargetName="SelectMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 状态胶囊：底色 + 圆点 + 文字三处一起换 -->
            <DataTemplate x:Key="StatusCell">
                <Border x:Name="Badge" CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="12,0,8,0" Background="#FEF2F2">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#DC2626"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="Label" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" Foreground="#B91C1C"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="已回复">
                        <Setter TargetName="Badge" Property="Background" Value="#FFFBEB"/>
                        <Setter TargetName="Dot" Property="Fill" Value="#D97706"/>
                        <Setter TargetName="Label" Property="Foreground" Value="#B45309"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="已完成">
                        <Setter TargetName="Badge" Property="Background" Value="#ECFDF5"/>
                        <Setter TargetName="Dot" Property="Fill" Value="#10B981"/>
                        <Setter TargetName="Label" Property="Foreground" Value="#047857"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- 顶部状态筛选胶囊（互斥单选） -->
            <Style x:Key="Chip" TargetType="RadioButton">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ChipBorder" CornerRadius="14" Padding="12,5"
                                    Background="Transparent" BorderThickness="1" BorderBrush="#E3E9F2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.FontSize="12"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 详情区字段名 / 字段值 -->
            <Style x:Key="InfoLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="InfoValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ 头部：标题 + 状态筛选 + 搜索/操作 ═════════ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,12">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="批注清单" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubTitle" Text="按编号归集，选中一行可在图纸中定位"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="10,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" GroupName="StatusFilter"
                                     Tag="" IsChecked="True" Checked="FilterChip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="全部"/>
                                <TextBlock x:Name="CountAll" Text="0" Margin="5,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChipPending" Style="{StaticResource Chip}" GroupName="StatusFilter"
                                     Tag="待处理" Checked="FilterChip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="待处理"/>
                                <TextBlock x:Name="CountPending" Text="0" Margin="5,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChipReplied" Style="{StaticResource Chip}" GroupName="StatusFilter"
                                     Tag="已回复" Checked="FilterChip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已回复"/>
                                <TextBlock x:Name="CountReplied" Text="0" Margin="5,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ChipDone" Style="{StaticResource Chip}" GroupName="StatusFilter"
                                     Tag="已完成" Checked="FilterChip_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已完成"/>
                                <TextBlock x:Name="CountDone" Text="0" Margin="5,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <!-- 搜索框：放 magnifier + 空文本水印 -->
                    <Grid Width="340" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Height="32" Padding="30,0,10,0"
                                 VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/>
                        <Path Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 M10.4,10.4 L14.6,14.6"
                              Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                              Stroke="#94A3B8" StrokeThickness="1.4"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="搜索 编号 / 图号 / 专业 / 意见内容" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Ctrl+F" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="刷新" Style="{DynamicResource SecondaryButton}" Height="32" MinWidth="60"
                                Padding="12,0" Margin="0" Click="Refresh_Click" ToolTip="重新读取当前图纸的批注（F5）"/>
                        <Button Content="导出清单" Style="{DynamicResource SecondaryButton}" Height="32" MinWidth="76"
                                Padding="12,0" Margin="8,0,0,0" Click="Export_Click"
                                ToolTip="导出为 CSV（Excel 可编辑）或 Word 回复单">
                            <Button.ContextMenu>
                                <ContextMenu FontSize="12">
                                    <MenuItem Header="导出 CSV（Excel 可编辑）" Click="ExportCsv_Click"/>
                                    <MenuItem Header="导出 Word 回复单" Click="ExportWord_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="新建批注" Style="{DynamicResource PrimaryButton}" Height="32" MinWidth="84"
                                Padding="14,0" Margin="8,0,0,0" Click="NewAnnotation_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═════════ 表格 ═════════ -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Margin="0,10,0,0" Padding="0,0,0,1">
            <ListView x:Name="AnnotationList" BorderThickness="0" Background="Transparent"
                      ItemContainerStyle="{StaticResource RowStyle}"
                      SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                      MouseDoubleClick="List_DoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ContextMenu>
                    <ContextMenu FontSize="12">
                        <MenuItem Header="定位到图纸" Click="Locate_Click"/>
                        <MenuItem Header="标记为已完成" Click="MarkDone_Click"/>
                        <MenuItem Header="标记为待处理" Click="MarkPending_Click"/>
                        <Separator/>
                        <MenuItem Header="删除批注" Click="Delete_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView AllowsColumnReorder="False"
                              ColumnHeaderContainerStyle="{StaticResource HeadStyle}">
                        <GridViewColumn Header="序号" Width="52">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Seq}" Style="{StaticResource CellText}"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="编号" Width="76">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource CellText}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="专业" Width="78">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Discipline}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="图号" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DrawingNoDisplay}" Style="{StaticResource CellText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="意见摘要" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CellText}">
                                        <TextBlock.ToolTip>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxWidth="420" FontSize="12"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="批注人" Width="76">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource CellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="标注时间" Width="106">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource CellText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="状态" Width="100" CellTemplate="{StaticResource StatusCell}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ═════════ 详情 ═════════ -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Margin="0,10,0,0" Padding="16,12" MinHeight="132">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 左：意见全文 -->
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="意见全文" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="DetailHead" Text="" FontSize="11" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="86" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DetailContent" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{StaticResource TextBrush}" Text="在列表里选一条批注查看全文。"/>
                    </ScrollViewer>
                    <TextBlock x:Name="DetailElements" Text="" FontSize="11" Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource CardBorderBrush}"/>

                <!-- 右：字段信息 -->
                <Grid Grid.Column="2" Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="21"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="编号" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="DetailNumber" Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="批注人" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="DetailAuthor" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="图号" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="DetailDrawingNo" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="图层" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="DetailLayer" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="图纸" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="DetailLayout" Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValue}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="指纹" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="DetailFingerprint" Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoValue}"
                               FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═════════ 底部统计与操作 ═════════ -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FooterStats" Text="共 0 条" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <!-- 操作结果回显：改状态成功/失败、命令发没发出去都写在这儿，不再"点了没反应" -->
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Margin="0,2,0,0"
                           Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="定位到图纸" Style="{DynamicResource SecondaryButton}" Height="32" MinWidth="88"
                        Padding="12,0" Margin="0" Click="Locate_Click"
                        ToolTip="缩放到选中的批注，并把清单最小化让出图纸"/>
                <Button Style="{DynamicResource PrimaryButton}" Height="32" MinWidth="96"
                        Padding="14,0" Margin="8,0,0,0" Click="Mark_Click"
                        ToolTip="把选中的批注标记为待处理 / 已回复 / 已完成">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="标记状态" VerticalAlignment="Center"/>
                        <!-- 下三角用 Path 画：字体里的 ▾ 在 12px 下会糊成一个小点 -->
                        <Path Data="M0,0 L9,0 L4.5,6 Z" Margin="7,2,0,0" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu FontSize="12" Placement="Top">
                            <MenuItem Header="待处理" Click="MarkPending_Click"/>
                            <MenuItem Header="已回复" Click="MarkReplied_Click"/>
                            <MenuItem Header="已完成" Click="MarkDone_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="关闭" Style="{DynamicResource SecondaryButton}" Height="32" MinWidth="72"
                        Padding="12,0" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
