<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoRoot)bin\</OutputPath>
    <OutputType>Library</OutputType>
    <RootNamespace>XAnnotation</RootNamespace>
    <AssemblyName>XAnnotation.ZWCAD</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <DefineConstants>ZWCAD</DefineConstants>
    <!-- 中望 ZWCAD 的托管 API 就在安装目录根下：ZwManaged.dll + ZwDatabaseMgd.dll。
         换机器/换版本时用命令行覆盖：
           dotnet build src\XAnnotation.csproj -c Release -p:ZwcadDir="D:\path\to\ZWCAD 20xx" -->
    <ZwcadDir Condition="'$(ZwcadDir)' == ''">C:\Program Files\ZWSOFT\ZWCAD 2026</ZwcadDir>
    <!-- 老版本装在 ...\ZWSOFT\ZWCAD Enterprise 时自动回退 -->
    <ZwcadDir Condition="!Exists('$(ZwcadDir)\ZwManaged.dll') And Exists('C:\Program Files\ZWSOFT\ZWCAD Enterprise\ZwManaged.dll')">C:\Program Files\ZWSOFT\ZWCAD Enterprise</ZwcadDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ZwManaged"><HintPath>$(ZwcadDir)\ZwManaged.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ZwDatabaseMgd"><HintPath>$(ZwcadDir)\ZwDatabaseMgd.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <!-- 同上：net472 参考程序集来自 NuGet，无需 Visual Studio / targeting pack。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>
