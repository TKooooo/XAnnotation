<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <!--
    AutoCAD 2014 专用构建（.NET 4.0 + 直接对着本机 AutoCAD 2014 的托管程序集）。

    为什么单独一个目标，而不是用 net45 那份：
      1) 官方对照表（Autodesk「关于 Managed .NET 的兼容性」）写明
         AutoCAD 2012/2013/2014 支持的 .NET Framework 是 **4.0**，2015 起才升到 4.5。
         AutoCAD 2014 全新安装带的是 .NET 4.0；只装了 4.0 的机器（Win7 上很常见）
         加载 net45 产物会失败 —— 典型现场就是"Win10 上正常、Win7 上加载后没反应"
         （Win10 自带 .NET 4.6+，恰好掩盖了这个问题）。这里钉 net40 才能覆盖 4.0。
      2) net45 那份引用的是 NuGet 包 AutoCAD.NET 20.0.0（= AutoCAD 2015 的程序集），
         装到 2014 上靠宿主的版本重定向兜着。这里改为**直接引用本机 AutoCAD 2014 自带的
         acdbmgd/acmgd/accoremgd（19.1）**，版本完全对齐，不再依赖重定向。

    与其它目标共用全部源码，差异只靠编译符号表达：
      AUTOCAD             —— 宿主是 AutoCAD（非 ZWCAD）
      WPF_NO_PIXELSPERDIP —— net40 的 FormattedText 还没有 pixelsPerDip 重载（4.6.2 才加入）
    这里**不能**定义 ACAD_PRE2013（2013 起 Editor 已在 accoremgd）也不能定义 ACAD_CORE
    （那个符号是给 AutoCAD 2025+ 的 Core 分支用的），走的是源码里的 19.x 分支。
  -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(RepoRoot)bin-acad2014\</OutputPath>
    <OutputType>Library</OutputType>
    <RootNamespace>XAnnotation</RootNamespace>
    <AssemblyName>XAnnotation.AutoCAD2014</AssemblyName>
    <!-- AutoCAD 2014 有 32 位与 64 位两种安装，AnyCPU 才能在两边都加载。 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <DefineConstants>AUTOCAD;WPF_NO_PIXELSPERDIP</DefineConstants>
    <!-- 默认取本机安装目录；换机器编译时用命令行覆盖：
           dotnet build src\XAnnotation.AutoCAD2014.csproj -c Release -p:Acad2014Dir="D:\AutoCAD 2014"
         目录里只要有 acdbmgd.dll / acmgd.dll / accoremgd.dll 即可，不要求是完整安装。 -->
    <Acad2014Dir Condition="'$(Acad2014Dir)' == ''">C:\Program Files\Autodesk\AutoCAD 2014</Acad2014Dir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=false：运行时用 CAD 宿主自带的同名程序集，不要把这三个 DLL 拷进产物目录（会与宿主冲突）。 -->
    <Reference Include="acdbmgd"><HintPath>$(Acad2014Dir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(Acad2014Dir)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="accoremgd"><HintPath>$(Acad2014Dir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <!-- System.ValueTuple：AnnotationService.UcsAlignedExtents 用了命名元组返回值，net40 上没有该类型。
         注意运行时把 System.ValueTuple.dll 与主 DLL 放在同一目录（build.cmd release 会自动带上）。 -->
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <!-- 只装 .NET SDK（未装 Visual Studio）的机器上没有 net40 参考程序集，靠这个包补齐，避免 MSB3644。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- 缺 DLL 时给出人话提示，而不是抛一堆 CS0246 / MSB3243。
       Error 是 Task 不是 Item，必须放在 Target 里。 -->
  <Target Name="EnsureAcad2014Assemblies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Acad2014Dir)\acdbmgd.dll') Or !Exists('$(Acad2014Dir)\acmgd.dll') Or !Exists('$(Acad2014Dir)\accoremgd.dll')"
           Text="未找到 AutoCAD 2014 的托管程序集（acdbmgd.dll / acmgd.dll / accoremgd.dll）。请安装 AutoCAD 2014，或把这三个 DLL 拷到任意目录后用 -p:Acad2014Dir=&quot;该目录&quot; 指定。当前 Acad2014Dir=$(Acad2014Dir)" />
  </Target>
</Project>
